rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: vérifie que l'utilisateur est le parent propriétaire du document
    function isParent(parentId) {
      return request.auth != null && request.auth.uid == parentId;
    }

    // Helper "local": vérifie que l'appareil enfant est celui appairé,
    // en utilisant DIRECTEMENT resource.data (pas de get() => pas de boucle).
    // À utiliser UNIQUEMENT dans les règles du document children/{childId} lui-même.
    function isChildDeviceLocal() {
      return request.auth != null
          && resource.data.childDeviceUid == request.auth.uid;
    }

    // Helper "externe": pour les sous-collections (rules, alerts, etc.)
    // qui ont besoin d'aller chercher le childDeviceUid sur le doc parent enfant.
    // Ce get() est sûr ici car la règle sur children/{childId} n'appelle plus get().
    function isChildDevice(parentId, childId) {
      return request.auth != null
          && get(/databases/$(database)/documents/parents/$(parentId)/children/$(childId)).data.childDeviceUid == request.auth.uid;
    }

    // ── Données parent ───────────────────────────────────────────────────────
    match /parents/{parentId} {
      allow read, write: if isParent(parentId);

      // ── Enfants ─────────────────────────────────────────────────────────────
      match /children/{childId} {
        // Parent : accès complet
        allow read, write: if isParent(parentId);

        // Appareil enfant : lecture de ses propres données
        // (version "locale" : pas de get(), évite la dépendance circulaire)
        allow read: if isChildDeviceLocal();

        // Appareil enfant : mise à jour limitée (heartbeat, statut, FCM token)
        allow update: if isChildDeviceLocal()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'deviceStatus', 'lastHeartbeat', 'fcmToken', 'lastTokenSync'
            ]);

        // Appairage : un nouvel appareil peut s'appairer en définissant isLinked + childDeviceUid
        allow update: if request.auth != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'isLinked', 'childDeviceUid', 'deviceStatus', 'lastHeartbeat'
            ])
            && request.resource.data.isLinked == true
            && request.resource.data.childDeviceUid == request.auth.uid;

        // ── Règles (Rules Repository) ──────────────────────────────────────
        match /rules/active {
          // Parent : lecture et écriture complètes
          allow read, write: if isParent(parentId);
          // Appareil enfant : lecture uniquement de ses propres règles
          allow read: if isChildDevice(parentId, childId);
        }

        // ── Alertes (Alert Repository) ───────────────────────────────────
        match /alerts/{alertDoc=**} {
          allow read, write: if isParent(parentId);
          // Appareil enfant : lecture ET écriture (stats d'usage, notifications)
          allow read, write: if isChildDevice(parentId, childId);
        }

        // ── Statistiques d'usage ─────────────────────────────────────────
        match /usageStats/{statDoc} {
          allow read: if isParent(parentId);
          allow read, write: if isChildDevice(parentId, childId);
        }

        // ── Inventaire (Apps / Web history) ─────────────────────────────
        // L'appareil enfant doit pouvoir écrire ici pour synchroniser
        // les noms d'apps, icônes, et historique web.
        match /inventory/{invDoc=**} {
          allow read, write: if isParent(parentId);
          allow read, write: if isChildDevice(parentId, childId);
        }

        // ── Position GPS ─────────────────────────────────────────────────
        match /location/current {
          allow read: if isParent(parentId);
          allow read, write: if isChildDevice(parentId, childId);
        }
      }

      // ── Géofences ─────────────────────────────────────────────────────────
      match /geofences/{geofenceId} {
        allow read, write: if isParent(parentId);
      }

      // ── Vérification OTP ──────────────────────────────────────────────────
      match /verification/{doc} {
        allow read, write: if isParent(parentId);
      }
    }

    // ── Appairage : recherche par invitationToken ─────────────────────────
    // Permet à tout utilisateur authentifié (y compris anonymement) de chercher
    // un document enfant via collectionGroup pour valider le code d'appairage.
    match /{path=**}/children/{childId} {
      allow read: if request.auth != null
          && resource.data.invitationToken != null;
    }
  }
}
