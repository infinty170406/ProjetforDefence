<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0D0D0D"
    android:padding="28dp">

    <!-- Warning / Lock Icon -->
    <ImageView
        android:id="@+id/block_icon"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@android:drawable/ic_lock_idle_lock"
        android:tint="#FF3B30"
        android:layout_marginBottom="24dp" />

    <!-- Title -->
    <TextView
        android:id="@+id/block_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Accès restreint"
        android:textColor="#FFFFFF"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <!-- Reason Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1C1C1E"
        android:padding="16dp"
        android:layout_marginBottom="32dp">

        <TextView
            android:id="@+id/block_reason_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cette application est bloquée par vos parents."
            android:textColor="#E5E5EA"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2" />
    </LinearLayout>

    <!-- Return to Home Button -->
    <Button
        android:id="@+id/btn_back_to_home"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:text="Fermer"
        android:textColor="#FFFFFF"
        android:backgroundTint="#2C2C2E"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
